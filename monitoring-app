server {
    listen 80;
    server_name _;
    return 301 https://$host$request-uri;    
}

server {
    listen 443 ssl;
    server_name _;
    ssl_certificate     /etc/ssl/certs/monitoring-app.crt;
    ssl_certificate_key /etc/ssl/private/monitoring-app.key;

    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}
